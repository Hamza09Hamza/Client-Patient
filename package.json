{
  "name": "clinic-patient",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find tests -name '*.test.ts')",
    "check": "npm run lint && npm run typecheck && npm test && npx prisma validate",
    "check:release": "bash scripts/check.sh --release",
    "push:verified": "bash scripts/push.sh",
    "postinstall": "prisma generate",
    "deploy": "bash scripts/deploy.sh",
    "status:server": "bash scripts/status.sh",
    "check:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "check:win:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1 -Release",
    "push:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push.ps1",
    "deploy:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "status:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "ogl": "^1.0.11",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
