generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PatientStatus {
  ACTIVE
  DISABLED
}

enum ResultStatus {
  PENDING
  COMPLETED
  REVIEWED
}

enum ActorType {
  PATIENT
  SYSTEM
}

model Patient {
  id            String        @id @default(cuid())
  patientId     String        @unique // clinic-issued identifier (e.g. "PAT-2026-0001") — ties
                                       // pushed reports to this patient, not used to log in
  // short generated login identifier (8 chars, see generateUsername in
  // src/lib/password.ts) — separate from patientId so login credentials stay
  // short and simple regardless of the clinic's own ID format. Generated once
  // at provisioning.
  username      String        @unique
  fullName      String
  email         String?
  phone         String?
  dateOfBirth   DateTime?
  gender        String?
  status        PatientStatus @default(ACTIVE)
  // scrypt hash ("salt:hash", see src/lib/password.ts) — the plaintext is
  // returned exactly once when the patient is first provisioned through
  // POST /api/integration/patients, for the clinic's own system (SERVER A)
  // to retain; it is never stored, rotated, or retrievable here again
  passwordHash  String
  lastLoginAt   DateTime?
  // human-readable OS/browser/device parsed from the User-Agent at last login,
  // e.g. "macOS · Safari" or "Android · Chrome Mobile (SM-G991B)" — best effort,
  // see src/lib/device.ts for why exact phone models aren't always available
  lastLoginDevice String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  results       LabResult[]

  @@index([fullName])
}

model LabResult {
  id                String       @id @default(cuid())
  reference         String       // lab accession / report number; may repeat for different patients
  patient           Patient      @relation(fields: [patientDbId], references: [id], onDelete: Cascade)
  patientDbId       String
  category          String // Hematology, Biochemistry, Serology, ...
  testName          String
  status            ResultStatus @default(COMPLETED)
  orderingPhysician String?
  specimen          String? // Blood, Urine, ...
  collectedAt       DateTime
  reportedAt        DateTime?
  notes             String?
  // set once this report's PDF arrives, pushed from the clinic's own system
  // (SERVER A) — see src/app/api/integration/reports/route.ts. When present,
  // the portal shows the PDF viewer instead of an "in progress" notice.
  sourceRef         String? // SERVER A's document id, for idempotent re-push
  pdfPath           String? // filename under uploads/reports/ — never a URL, always local
  pdfSha256         String? // lowercase SHA-256 hex; makes immutable upload retries verifiable
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  shareGrants       ReportShareGrant[]

  @@unique([patientDbId, sourceRef])
  @@index([reference])
  @@index([patientDbId, collectedAt(sort: Desc)])
  @@index([category])
  @@index([status])
}

// A scoped, revocable bearer grant for viewing exactly one report without a
// patient login — minted when a report is delivered (never for a bulk sync)
// and handed out as a QR code. The raw secret is never stored, only its hash
// (see src/lib/report-share.ts) — a fresh QR can't be re-derived from this
// row later, only a brand-new grant can be minted.
model ReportShareGrant {
  id              String    @id @default(cuid())
  publicId        String    @unique // short id in the /r/{publicId} URL
  result          LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  labResultId     String
  tokenHash       String // sha256 hex of the opaque secret carried in the QR URL fragment — used for verification
  // AES-256-GCM ciphertext of the same opaque secret, keyed by
  // REPORT_SHARE_ENCRYPTION_KEY (see src/lib/report-share.ts). Verification
  // never touches this column — it exists solely so the *same* QR minted at
  // appointment time can be reissued unchanged once the report's PDF lands,
  // instead of minting a second, different grant. Null for grants minted
  // before this column existed; those can only be reissued as a new grant.
  tokenEncrypted  String?
  expiresAt       DateTime
  revokedAt       DateTime?
  redemptionCount Int       @default(0)
  createdAt       DateTime  @default(now())
  lastAccessedAt  DateTime?

  @@index([labResultId])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType
  actorId   String // patient ID / "integration" / "seed"
  action    String // e.g. PATIENT_CREATED, PATIENT_ALREADY_EXISTS, LOGIN, RESULT_VIEWED
  target    String? // e.g. patient ID or result reference the action applies to
  detail    String?
  createdAt DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorType, actorId])
}
