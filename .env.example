# Local development example. Never commit real credentials.
DATABASE_URL=postgresql://clinic:clinic_dev_password@localhost:5433/clinic_portal
AUTH_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_API_KEY=replace-with-a-different-random-api-key
REPORT_SHARE_ENCRYPTION_KEY=replace-with-a-third-distinct-32-char-secret
PUBLIC_BASE_URL=http://localhost:3000

# Optional: comma-separated origins allowed to access the Next.js dev server.
# ALLOWED_DEV_ORIGINS=192.168.1.20:3000
